---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import CitationBox from '../../components/CitationBox.astro';

export async function getStaticPaths() {
  const instruments = await getCollection('instruments');
  return instruments.map(inst => {
    const rawSlug = inst.data.slug || inst.id;
    return {
      params: { slug: decodeURIComponent(rawSlug) },
      props: { instrument: inst },
    };
  });
}

const { instrument } = Astro.props;
const { Content } = await render(instrument);
const data = instrument.data;

const familyNames: Record<string, string> = {
  aerofones: 'Aerofones',
  cordofones: 'Cordofones',
  idiofones: 'Idiofones',
  membranofones: 'Membranofones',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['ScholarlyArticle', 'MusicInstrument'],
  'name': data.title,
  'headline': data.title,
  'description': data.description || `Verbete sobre ${data.title}, instrumento da família dos ${data.family}.`,
  'instrument': data.title,
  'category': familyNames[data.family],
  'identifier': data.mimo_code ? `MIMO ${data.mimo_code}` : undefined,
  'author': {
    '@type': 'Person',
    'name': data.author || 'Equipe LABEET',
  },
  'editor': {
    '@type': 'Person',
    'name': data.reviewer || 'Alice L. Satomi',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Laboratório de Estudos Etnomusicológicos (LABEET/UFPB)',
    'url': 'https://brazil-instrumentarium.github.io',
  },
  'image': data.images.length > 0 ? `https://brazil-instrumentarium.github.io/${data.images[0].file}` : undefined,
  'datePublished': data.published_date || undefined,
  'dateModified': data.modified_date || undefined,
};
---

<BaseLayout title={data.title} description={`Verbete sobre ${data.title}, instrumento da família dos ${data.family} no acervo Instrumentos musicais da diversidade brasileira (LABEET/UFPB).`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12" data-pagefind-body>
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 mb-6 font-sans" data-pagefind-ignore>
      <a href="/" class="hover:text-[#0A5517]">Início</a>
      <span>&rsaquo;</span>
      <a href={`/familia/${data.family}`} class="hover:text-[#0A5517] capitalize">{familyNames[data.family]}</a>
      <span>&rsaquo;</span>
      <span class="text-stone-800 font-medium">{data.title}</span>
    </nav>

    <!-- Cabeçalho do Verbete -->
    <header class="border-b border-stone-200 pb-8 mb-8">
      <div class="flex items-center gap-2.5 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#0A5517]/10 text-[#0A5517] border border-[#0A5517]/25">
          {familyNames[data.family]}
        </span>
        {data.mimo_code && (
          <span class="px-3 py-1 rounded-full text-xs font-mono bg-stone-100 text-stone-700 border border-stone-200 font-medium">
            MIMO {data.mimo_code}
          </span>
        )}
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-stone-900 tracking-tight mb-2 leading-tight">
        {data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-stone-500 font-sans mt-4">
        {data.author && <div><strong class="text-stone-700">Elaboração:</strong> {data.author}</div>}
        {data.reviewer && <div><strong class="text-stone-700">Revisão Científica:</strong> {data.reviewer}</div>}
        {data.published_date && <div><strong class="text-stone-700">Publicação original:</strong> {data.published_date}</div>}
      </div>
    </header>

    <!-- Corpo do Artigo em Markdown -->
    <div class="prose prose-stone prose-lg max-w-none prose-headings:font-serif prose-headings:text-stone-900 prose-a:text-[#0A5517] hover:prose-a:text-[#00420c] prose-img:rounded-xl">
      <Content />
    </div>

    <!-- Mídias e Fonografia -->
    <MediaGallery images={data.images} instrumentTitle={data.title} />
    <AudioPlayer links={data.audio_video_links} />

    <!-- Referências Bibliográficas -->
    {data.references.length > 0 && (
      <section class="my-10 p-6 bg-stone-50 rounded-2xl border border-stone-200">
        <h3 class="font-serif font-bold text-lg text-stone-900 mb-4 flex items-center gap-2">
          <span>📖</span> Referências Bibliográficas
        </h3>
        <ul class="space-y-2 text-xs text-stone-600 list-disc pl-5 leading-relaxed">
          {data.references.map(ref => (
            <li>{ref}</li>
          ))}
        </ul>
      </section>
    )}

    <!-- Como Citar -->
    <CitationBox title={data.title} author={data.author} reviewer={data.reviewer} slug={instrument.slug || data.slug || ''} />
  </article>
</BaseLayout>
