---
interface Props {
  activeTab?: string;
}
const { activeTab = "" } = Astro.props;
---

<header class="bg-[#0A5517] text-white shadow-md sticky top-0 z-40 border-b-2 border-[#D97706]/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3.5 group">
      <div class="w-11 h-11 rounded-lg bg-white/10 border border-white/20 flex items-center justify-center text-[#F59E0B] font-serif font-bold text-2xl shadow-inner group-hover:bg-white/20 transition-colors">
        B
      </div>
      <div>
        <span class="block font-serif font-bold text-white text-lg sm:text-xl leading-tight tracking-tight group-hover:text-amber-200 transition-colors">
          Instrumentos musicais da diversidade brasileira
        </span>
        <span class="block text-[11px] font-sans text-emerald-200/90 uppercase tracking-widest">
          Laboratório de Estudos Etnomusicológicos &bull; LABEET
        </span>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-sm font-medium text-emerald-100">
      <a href="/" class={`hover:text-amber-300 transition-colors pb-1 ${activeTab === "inicio" ? "text-amber-300 border-b-2 border-amber-300 font-semibold" : ""}`}>Acervo</a>
      <a href="/familia/aerofones" class="hover:text-amber-300 transition-colors pb-1">Aerofones</a>
      <a href="/familia/cordofones" class="hover:text-amber-300 transition-colors pb-1">Cordofones</a>
      <a href="/familia/idiofones" class="hover:text-amber-300 transition-colors pb-1">Idiofones</a>
      <a href="/familia/membranofones" class="hover:text-amber-300 transition-colors pb-1">Membranofones</a>
      <a href="/sobre" class={`hover:text-amber-300 transition-colors pb-1 ${activeTab === "sobre" ? "text-amber-300 border-b-2 border-amber-300 font-semibold" : ""}`}>Sobre</a>
    </nav>

    <div class="flex items-center gap-3">
      <button id="search-trigger" class="flex items-center gap-2.5 px-3.5 py-1.5 text-xs text-emerald-100 bg-black/25 hover:bg-black/40 rounded-full border border-white/20 hover:border-amber-400/60 transition-all shadow-sm">
        <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <span class="hidden sm:inline text-white/90">Buscar no acervo...</span>
        <kbd class="font-mono bg-white/15 text-amber-200 px-1.5 py-0.5 rounded text-[10px] border border-white/20">⌘K</kbd>
      </button>
    </div>
  </div>
</header>
