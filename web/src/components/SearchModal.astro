---
---

<div id="search-modal" class="fixed inset-0 z-50 bg-stone-900/60 backdrop-blur-sm hidden items-start justify-center pt-16 sm:pt-24 p-4">
  <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl border border-stone-200 overflow-hidden flex flex-col max-h-[80vh]">
    <div class="p-4 border-b border-stone-200 flex items-center gap-3">
      <svg class="w-5 h-5 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <input
        id="search-input"
        type="text"
        placeholder="Buscar por instrumento, ritmo (capoeira, maracatu), material ou autor..."
        class="w-full text-base font-sans text-stone-900 placeholder-stone-400 focus:outline-none bg-transparent"
        autocomplete="off"
      />
      <button id="search-close" class="text-xs text-stone-400 hover:text-stone-600 bg-stone-100 px-2 py-1 rounded">
        Esc
      </button>
    </div>

    <div id="search-results" class="p-4 overflow-y-auto space-y-3 flex-grow divide-y divide-stone-100">
      <p class="text-xs text-stone-400 text-center py-8">
        Digite para pesquisar em todos os 165 verbetes e transcrições do acervo...
      </p>
    </div>
  </div>
</div>

<script is:inline type="module">
  let pagefind = null;
  let pagefindLoading = null;
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input');
  const resultsDiv = document.getElementById('search-results');
  const trigger = document.getElementById('search-trigger');
  const closeBtn = document.getElementById('search-close');

  let pagefindError = null;

  async function initPagefind() {
    if (pagefind) return pagefind;
    if (pagefindLoading) return pagefindLoading;

    pagefindLoading = (async () => {
      try {
        const pf = await import('/pagefind/pagefind.js');
        await pf.init();
        pagefind = pf;
        pagefindError = null;
        return pf;
      } catch (e) {
        console.error('Falha ao carregar Pagefind:', e);
        pagefindError = e;
        return null;
      } finally {
        pagefindLoading = null;
      }
    })();

    return pagefindLoading;
  }

  let selectedIndex = -1;

  function updateSelectedCard(items) {
    items.forEach((item, idx) => {
      if (idx === selectedIndex) {
        item.classList.add('bg-amber-100/80', 'ring-2', 'ring-[#0A5517]/40', 'border-[#0A5517]/30');
        item.classList.remove('hover:bg-amber-50');
        item.setAttribute('aria-selected', 'true');
        item.scrollIntoView({ block: 'nearest' });
      } else {
        item.classList.remove('bg-amber-100/80', 'ring-2', 'ring-[#0A5517]/40', 'border-[#0A5517]/30');
        item.classList.add('hover:bg-amber-50');
        item.setAttribute('aria-selected', 'false');
      }
    });
  }

  function getResultCards() {
    return Array.from(resultsDiv?.querySelectorAll('.search-result-card') || []);
  }

  function openModal() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    selectedIndex = -1;
    input?.focus();
    initPagefind();
  }

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    selectedIndex = -1;
    if (input) input.value = '';
    if (resultsDiv) resultsDiv.innerHTML = '<p class="text-xs text-stone-400 text-center py-8">Digite para pesquisar em todos os 165 verbetes e transcrições do acervo...</p>';
  }

  trigger?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openModal();
      return;
    }

    if (modal?.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeModal();
      return;
    }

    const cards = getResultCards();

    if (e.key === 'ArrowDown') {
      if (!cards.length) return;
      e.preventDefault();
      if (selectedIndex < cards.length - 1) {
        selectedIndex++;
        updateSelectedCard(cards);
      }
    } else if (e.key === 'ArrowUp') {
      if (!cards.length) return;
      if (selectedIndex === 0) {
        e.preventDefault();
        selectedIndex = -1;
        updateSelectedCard(cards);
        input?.focus();
      } else if (selectedIndex > 0) {
        e.preventDefault();
        selectedIndex--;
        updateSelectedCard(cards);
      }
    } else if (e.key === 'Enter') {
      if (selectedIndex >= 0 && cards[selectedIndex]) {
        e.preventDefault();
        cards[selectedIndex].click();
      } else if (selectedIndex === -1 && cards.length > 0 && document.activeElement === input) {
        e.preventDefault();
        cards[0].click();
      }
    }
  });

  input?.addEventListener('input', async (e) => {
    const q = e.target.value.trim();
    selectedIndex = -1;
    if (!q || !resultsDiv) return;

    const pf = await initPagefind();
    if (!pf || !pagefind) {
      const errMsg = pagefindError ? String(pagefindError?.message || pagefindError) : 'Índice de busca não carregado.';
      resultsDiv.innerHTML = `<p class="text-xs text-amber-700 bg-amber-50 p-4 rounded-xl text-center border border-amber-200">Não foi possível carregar a busca no momento.<br><span class="text-[11px] text-stone-500 font-mono mt-1 block">${errMsg}</span></p>`;
      return;
    }

    const search = await pagefind.search(q);
    resultsDiv.replaceChildren();

    if (!search.results.length) {
      const emptyP = document.createElement('p');
      emptyP.className = 'text-xs text-stone-500 text-center py-8';
      emptyP.appendChild(document.createTextNode('Nenhum instrumento encontrado para "'));
      const strong = document.createElement('strong');
      strong.textContent = q;
      emptyP.appendChild(strong);
      emptyP.appendChild(document.createTextNode('".'));
      resultsDiv.appendChild(emptyP);
      return;
    }

    const five = search.results.slice(0, 5);
    const data = await Promise.all(five.map((r) => r.data()));

    const fragment = document.createDocumentFragment();
    data.forEach((item, index) => {
      const card = document.createElement('a');
      card.href = item.url;
      card.className = 'search-result-card block p-3 rounded-xl border border-transparent hover:bg-amber-50 transition-all cursor-pointer';
      card.setAttribute('role', 'option');
      card.setAttribute('aria-selected', 'false');
      card.setAttribute('data-index', String(index));

      card.addEventListener('mouseenter', () => {
        selectedIndex = index;
        updateSelectedCard(getResultCards());
      });

      const titleH4 = document.createElement('h4');
      titleH4.className = 'font-serif font-bold text-stone-900 text-base mb-1';
      titleH4.textContent = item.meta.title || 'Verbete';
      card.appendChild(titleH4);

      const excerptP = document.createElement('p');
      excerptP.className = 'text-xs text-stone-600 line-clamp-2';
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = item.excerpt || '';
      tempDiv.querySelectorAll('script, iframe, object, embed, img, svg, form').forEach(el => el.remove());
      excerptP.replaceChildren(...Array.from(tempDiv.childNodes));
      card.appendChild(excerptP);

      fragment.appendChild(card);
    });

    resultsDiv.appendChild(fragment);
  });
</script>
