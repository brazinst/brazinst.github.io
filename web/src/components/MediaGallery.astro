---
interface ImageItem {
  file: string;
  caption?: string;
  rights?: string;
}

interface Props {
  images: ImageItem[];
  instrumentTitle: string;
}

const { images, instrumentTitle } = Astro.props;
---

{images.length > 0 && (
  <section class="my-10 bg-stone-100/70 p-6 rounded-2xl border border-stone-200">
    <div class="flex items-center justify-between mb-6">
      <h3 class="font-serif font-bold text-xl text-stone-900 flex items-center gap-2">
        <span>📷</span> Registros Iconográficos e Fotografias
      </h3>
      <span class="text-xs text-stone-500 font-sans">Clique na imagem para ampliar</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {images.map((img, idx) => (
        <figure class="bg-white rounded-xl overflow-hidden shadow-sm border border-stone-200 flex flex-col group cursor-pointer">
          <button
            type="button"
            class="lightbox-trigger block relative w-full aspect-[4/3] overflow-hidden text-left focus:outline-none focus:ring-2 focus:ring-[#0A5517]"
            data-src={`/${img.file}`}
            data-caption={img.caption || `${instrumentTitle} - Imagem ${idx + 1}`}
            data-rights={img.rights || ''}
            aria-label={`Ampliar foto: ${img.caption || instrumentTitle}`}
          >
            <img
              src={`/${img.file}`}
              alt={img.caption || `${instrumentTitle} - Imagem ${idx + 1}`}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
              <span class="bg-stone-900/80 text-white text-xs px-3 py-1.5 rounded-full backdrop-blur-xs font-medium flex items-center gap-1.5 shadow-lg">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path></svg>
                Ampliar
              </span>
            </div>
          </button>
          {img.caption && (
            <figcaption class="p-3 text-xs text-stone-600 bg-stone-50 border-t border-stone-100">
              <span class="font-medium text-stone-800">{img.caption}</span>
              {img.rights && <span class="block text-stone-400 mt-0.5">Créditos: {img.rights}</span>}
            </figcaption>
          )}
        </figure>
      ))}
    </div>

    <!-- Lightbox Modal -->
    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm hidden items-center justify-center p-4 sm:p-6" role="dialog" aria-modal="true" aria-hidden="true">
      <button
        id="lightbox-close"
        type="button"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 text-white/80 hover:text-white bg-white/10 hover:bg-white/20 p-2 rounded-full transition-colors z-10 cursor-pointer"
        aria-label="Fechar ampliação"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
      <div class="max-w-4xl max-h-[90vh] flex flex-col items-center">
        <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[75vh] object-contain rounded-lg shadow-2xl" />
        <div id="lightbox-caption-container" class="mt-4 text-center text-white font-sans max-w-2xl px-4">
          <p id="lightbox-caption" class="text-sm sm:text-base font-medium leading-relaxed"></p>
          <p id="lightbox-rights" class="text-xs text-stone-400 mt-1"></p>
        </div>
      </div>
    </div>
  </section>
)}

<script>
  const modal = document.getElementById('lightbox-modal');
  const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const captionEl = document.getElementById('lightbox-caption');
  const rightsEl = document.getElementById('lightbox-rights');
  const closeBtn = document.getElementById('lightbox-close');
  const triggers = document.querySelectorAll('.lightbox-trigger');

  function openLightbox(src: string, caption: string, rights: string) {
    if (!modal || !modalImg) return;
    modalImg.src = src;
    modalImg.alt = caption;
    if (captionEl) captionEl.textContent = caption;
    if (rightsEl) rightsEl.textContent = rights ? `Créditos: ${rights}` : '';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    if (modalImg) modalImg.src = '';
    document.body.style.overflow = '';
  }

  triggers.forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src') || '';
      const caption = btn.getAttribute('data-caption') || '';
      const rights = btn.getAttribute('data-rights') || '';
      openLightbox(src, caption, rights);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal || (e.target as HTMLElement).tagName === 'DIV') {
      closeLightbox();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeLightbox();
    }
  });
</script>
